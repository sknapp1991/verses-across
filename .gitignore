# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.production

# GlobalStudy
# downloaded source archives (re-created by scripts/import-*.ts)
/data/raw/
# server-side AI translation cache (Phase 2)
/.cache/

# Cloudflare (OpenNext / wrangler)
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example

# generated per-book bundles (scripts/pack-texts.ts)
/public/texts/

# generated search index (scripts/build-search.ts)
/public/search/

# generated word-card data (scripts/build-words.ts)
/public/words/

# generated Strong's tags + lexicon shards (scripts/build-strongs.ts, from data/strongs + data/lexicon)
/public/strongs/
/public/lexicon/

# local text-to-speech toolchain (audio v2 generation)
/.venv-tts/
/.cache-audio/
/public/audio/
/.cache-audio-samples/

# cross references (scripts/xref/build.py), uploaded to R2
/.cache-xref/
/public/redletter
/public/og/

# vertical clips made by scripts/make-shorts.mjs
/.cache-shorts/
