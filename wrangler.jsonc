{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snoopwiggy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by the adapter's caching; must match "name"
      "binding": "WORKER_SELF_REFERENCE",
      "service": "snoopwiggy"
    }
  ],
  // Recorded audio (audio v2), served by src/app/api/audio
  // Feedback reports from the in-app form (src/app/api/feedback): one JSON file per report, private
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "snoopwiggy-audio" },
    { "binding": "FEEDBACK", "bucket_name": "versesacross-feedback" },
    // Sync codes and study groups (src/app/api/sync, src/app/api/group): encrypted on the device, unreadable here
    { "binding": "SYNC", "bucket_name": "versesacross-sync" }
  ],
  // Built-in AI companion (src/app/api/ask): at most 8 questions a minute per visitor
  // Second AI model for the companion: OpenAI gpt-oss via Workers AI (no key; free daily allowance)
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    // Feedback form: at most 5 reports a minute per visitor
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Sync and groups: at most 60 requests a minute per visitor
    { "name": "SYNC_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Anonymous counts (src/app/api/count) and the private stats feed (src/app/api/stats)
    { "name": "STATS_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],
  // Anonymous daily totals (chapter views, read-along plays, downloads per work/version/language). No IPs or IDs.
  "d1_databases": [
    { "binding": "STATS_DB", "database_name": "versesacross-stats", "database_id": "1353e9b6-72a1-4507-a127-10ff268e7f29" }
  ],
  // Feedback reports are also emailed (src/app/api/feedback), from feedback@versesacross.com (Email Sending).
  // Cloudflare only sends to addresses verified on the account; the recipient is the secret FEEDBACK_TO
  // (set with: npx wrangler secret put FEEDBACK_TO), so no personal address is in this public repo.
  "send_email": [{ "name": "FEEDBACK_MAIL" }],
  "observability": { "enabled": true }
  // Worker name stays "snoopwiggy" (renaming re-creates the Worker). Custom domains attached in the dashboard:
  // versesacross.com + www (official, Verses Across) and snoopwiggy.com + www, which the app forwards to
  // versesacross.com together with the visitor's saved data (src/components/domain-move.tsx).
}
