// Mail guard (mail-guard/src/index.ts): Email Routing sends the @versesacross.com and @skylarknapp.com
// addresses here; it rejects risky attachments and spoofed mail, and forwards the rest.
// The destination is a secret, never in this file:
//   npx wrangler secret put FORWARD_TO --config mail-guard/wrangler.jsonc
// Deploy: npx wrangler deploy --config mail-guard/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "va-mail-guard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
